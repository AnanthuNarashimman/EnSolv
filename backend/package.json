{
  "name": "ensolv-backend",
  "version": "1.0.0",
  "description": "Aggregation API for Ensolv portfolio service",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "portfolio",
    "defi",
    "polygon",
    "rootstock",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.3.1",
    "ethers": "^6.8.1",
    "express": "^4.18.2",
    "graphql-request": "^6.1.0"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "jest": "^29.7.0",
    "jsdoc-to-markdown": "^9.1.2",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "globals": {
      "NODE_OPTIONS": "--experimental-vm-modules"
    },
    "transform": {},
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/tests/**"
    ]
  }
}
