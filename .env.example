# EnSolv Environment Configuration
# Copy this to .env and fill in your values

# API Configuration
# Set to 'true' to use real blockchain data, 'false' for mock backend
VITE_USE_REAL_API=true

# Set to 'true' to force real API only (no fallback to mock)
VITE_FORCE_REAL_API=false

# Ethereum RPC URL (Required for ENS resolution)
# Get free RPC from: https://eth.llamarpc.com or Alchemy/Infura
VITE_ETHEREUM_RPC_URL=https://eth.llamarpc.com

# Polygon RPC URL for Polygon data (Sponsor network)
VITE_POLYGON_RPC_URL=https://polygon-rpc.com

# Additional network RPC URLs for comprehensive portfolio coverage
VITE_BASE_RPC_URL=https://mainnet.base.org
VITE_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
VITE_OPTIMISM_RPC_URL=https://mainnet.optimism.io

# Optional: Covalent API key for enhanced token discovery
VITE_COVALENT_API_KEY=your_covalent_api_key_here

# Backend API URL (used when VITE_USE_REAL_API=false or as fallback)
VITE_API_BASE_URL=http://localhost:4000

# Production Backend API URL
# VITE_API_BASE_URL=https://your-production-api.com

# Development settings
VITE_DEBUG=false

# Feature flags for hackathon demo
VITE_ENABLE_KATANA_SWAPS=true
VITE_ENABLE_TOAST_NOTIFICATIONS=true

# Analytics and tracking (optional)
# VITE_ANALYTICS_ID=your_analytics_id